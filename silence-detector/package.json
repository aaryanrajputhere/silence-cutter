{
  "name": "silence-detector",
  "version": "1.0.0",
  "private": true,
  "description": "Local FFmpeg silence-detection test harness",
  "type": "module",
  "scripts": {
    "detect": "node --import tsx src/cli.ts",
    "test-folder": "node --import tsx src/testFolder.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node --import tsx scripts/integrationTest.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
